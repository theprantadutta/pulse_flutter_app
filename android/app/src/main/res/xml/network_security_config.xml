<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Most routers serve their admin page over plain HTTP on the LAN, and the
         router address differs per network, so the in-app router page needs
         cleartext. This only affects Android's own networking (the web view);
         Pulse's Dart networking doesn't use this file. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
